{
  "name": "@99galaxy/dsh-turn-notify",
  "version": "1.0.5",
  "description": "Windows 系统通知：DSH 会话本轮结束时提醒你，可选前台免打扰；点击通知拉回窗口。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "README.md",
    "cordis.patch.yml",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/smoke.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/99galaxy/dsh-turn-notify.git"
  },
  "homepage": "https://github.com/99galaxy/dsh-turn-notify#readme",
  "bugs": {
    "url": "https://github.com/99galaxy/dsh-turn-notify/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "notification", "windows"],
  "engines": {
    "node": ">=22.19"
  },
  "license": "MIT",
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
